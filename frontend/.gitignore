@"
# Dependencies
node_modules/

# Secrets
.env
.env.*
!.env.example

# Build files
build/
dist/
coverage/

# Logs
*.log

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Temporary files
*.tmp
*.bak
"@ | Set-Content -Encoding utf8 .gitignore